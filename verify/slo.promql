# name: traffic
sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_completed[1m]))

# name: error_rate
sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_xx{envoy_response_code_class="5"}[1m])) / sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_completed[1m]))

# name: latency_p95
histogram_quantile(0.95, sum by (envoy_cluster_name, le) (rate(envoy_cluster_upstream_rq_time_bucket[1m]))) / 1000
