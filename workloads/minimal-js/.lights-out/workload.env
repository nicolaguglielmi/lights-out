# Workload contract for the minimal-js repository (docs/adr/0030 §2, 0042
# §1, §9): the eleven keys the platform reads from .lights-out/ once this
# repository is attached (docs/adr/0037 §2). The gates half only: this
# repository has no plane half (no compose.yaml, no flag file), so the
# three plane keys are empty and `./go up` refuses it (docs/adr/0042 §7).
# Paths are relative to the repository's root. KEY=VALUE, one per line,
# no inline comments, no `$` or `#` in a value.

# No plane: no failing version to target.
CANARY_VERSION=

# Provenance, measurement: `./go mutation-baseline` on an attached copy of this
# directory, measured 2026-11-03 in the node image below (M20, the run is
# in .claude/context/HANDOFF.md): Stryker 10.1.1, 32 mutants, 30 killed,
# 2 survived (the two equivalent boundary mutants src/calc.js names),
# score 0.9375, 4s wall time warm. Re-measured only by a dedicated commit,
# when the suite or the tool changes.
MUTATION_BASELINE=0.9375

# No plane: no flag file, no kill switch.
WORKLOAD_KILL_SWITCH=

# No plane: nothing to probe.
WORKLOAD_SAMPLE_PATH=

# Scanned whole by gates/deps.sh (docs/adr/0015 §5): no dependencies, so
# the lock holds the root package only.
WORKLOAD_LOCKFILES=package-lock.json

# The diff gates/mutation.sh reads, and the directory the runners scan.
WORKLOAD_MUTATION_SCOPE=src/

# The sources sit at the repository root: nothing to strip.
WORKLOAD_TEST_ROOT=

# The runner contract (docs/adr/0042 §1-§2). The official node 24 image,
# by the manifest-list digest docker.io served for the tag on 2026-11-03,
# so the image form runs through the engine on this repository as
# committed; `./go init` on it drafts `workbench` instead (engines.node
# >=22 admits node 24), which demo-init proves without the engine. Not
# the slim variant: Stryker's command runner ends each test run with
# tree-kill, which needs `ps`, and node:24-slim ships none (found 2026-11-03).
TOOLCHAIN_IMAGE=docker.io/library/node:24@sha256:e7add2a490bb17d97b485b8641bd88455fff7839ade0f5eba493c3508124d413
TEST_CMD=npm ci && npm test
SAST_CMD=sh .lights-out/runners/sast.sh src
MUTATION_CMD=npm ci && sh .lights-out/runners/mutation.sh src "npm test"
