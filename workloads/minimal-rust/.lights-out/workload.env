# .lights-out/workload.env, drafted by ./go init on 2026-11-24 at 09b0f2e (docs/adr/0042 §6):
# the twelve keys the platform reads (docs/adr/0030 §2, 0042 §1, 0053 §1), each under
# a comment saying where its value comes from. KEY=VALUE, one per line, no
# inline comments, no `$` or `#` in a value. Paths are relative to the
# repository's root. Edit, then copy .lights-out/ into your repository and
# commit it: lights-out never writes there.

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7); fill in to run the plane
CANARY_VERSION=

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7); fill in to run the plane
WORKLOAD_KILL_SWITCH=

# Provenance, default: empty, the plane half is not drafted (docs/adr/0042 §7); fill in to run the plane
WORKLOAD_SAMPLE_PATH=

# Provenance, decision: minimal example baseline; re-measure inside docker.io/library/rust:1.85 with ./go mutation-baseline
MUTATION_BASELINE=1.0

# Provenance, inferred: Cargo.lock beside Cargo.toml (osv-scanner 2.6.0 scans Cargo.lock v3/v4 directly)
WORKLOAD_LOCKFILES=Cargo.lock

# Provenance, inferred: src/ holds Rust source files
WORKLOAD_MUTATION_SCOPE=src/

# Provenance, inferred: the crate sits at the repository root, nothing to strip
WORKLOAD_TEST_ROOT=

# Provenance, default: Rust integration tests under tests/ and *_test.rs modules
WORKLOAD_TEST_PATHS=tests/*.rs:tests/*/*.rs:*_test.rs:*/*_test.rs

# Provenance, inferred: Cargo.toml declares a Rust crate; the official rust 1.85 image, a tag: pin it by digest before committing (workbench has no Rust toolchain)
TOOLCHAIN_IMAGE=docker.io/library/rust:1.85

# Provenance, inferred: standard Cargo test suite
TEST_CMD=cargo test

# Provenance, default: Rust static security analyzer over the scope, the stack's runner (stacks/rust/runners/sast.sh)
SAST_CMD=sh .lights-out/runners/sast.sh src

# Provenance, default: line-scoped Rust mutator over the scope, the stack's runner (stacks/rust/runners/mutation.sh)
MUTATION_CMD=sh .lights-out/runners/mutation.sh src "cargo test"
