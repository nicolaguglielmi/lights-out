# Workload contract for the minimal-go service (docs/adr/0030 §2, 0102):
# the twelve keys the platform reads from .lights-out/ plus WORKLOAD_HEALTH_PROBE.
# KEY=VALUE, one per line, no inline comments, no `$` or `#` in a value.

CANARY_VERSION=0.2.0-broken
# Provenance, measurement: measured 2026-11-24 inside docker.io/library/golang:1.24
# with stacks/go/runners/mutation.sh: 10 mutants, 8 killed, 2 survived (the
# equivalent boundary mutants on lines 23 and 26 of pkg/calc/calc.go), score 0.8.
MUTATION_BASELINE=0.8
WORKLOAD_KILL_SWITCH=
WORKLOAD_HEALTH_PROBE=http:/ok
WORKLOAD_SAMPLE_PATH=/
# go.sum sits beside go.mod (checked by core/stacks.py); core/gates/deps.py
# passes go.mod directly to osv-scanner -L.
WORKLOAD_LOCKFILES=go.mod
WORKLOAD_MUTATION_SCOPE=pkg/
WORKLOAD_TEST_ROOT=
WORKLOAD_TEST_PATHS=*_test.go:*/*_test.go
TOOLCHAIN_IMAGE=docker.io/library/golang:1.24@sha256:d2d2bc1c84f7e60d7d2438a3836ae7d0c847f4888464e7ec9ba3a1339a1ee804
TEST_CMD=go test ./...
SAST_CMD=sh .lights-out/runners/sast.sh pkg
MUTATION_CMD=sh .lights-out/runners/mutation.sh pkg "go test ./..."
