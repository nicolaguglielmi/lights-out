# Workload contract for workloads/plain (ADR 0098): proves proxy SLO verification
# and rollback with zero OTel/prometheus_client/openfeature instrumentation and
# an empty WORKLOAD_KILL_SWITCH.

CANARY_VERSION=0.2.0-broken
# Provenance, decision: uninstrumented stdlib example workload; tests/test_server.py covers plain/server.py routes
MUTATION_BASELINE=1.0
WORKLOAD_KILL_SWITCH=
WORKLOAD_HEALTH_PROBE=http:/ok
WORKLOAD_SAMPLE_PATH=/
WORKLOAD_LOCKFILES=uv.lock
WORKLOAD_MUTATION_SCOPE=plain/
WORKLOAD_TEST_ROOT=
WORKLOAD_TEST_PATHS=tests/test_*.py
TOOLCHAIN_IMAGE=workbench
TEST_CMD=python3 -m unittest discover -s tests -q
SAST_CMD=bandit -r plain -q
MUTATION_CMD=python3 -m unittest discover -s tests -q
