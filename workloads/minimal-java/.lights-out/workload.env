# .lights-out/workload.env, drafted by ./go init on 2026-11-24 at 09b0f2e (docs/adr/0042 §6):
# the twelve keys the platform reads (docs/adr/0030 §2, 0042 §1, 0053 §1), each under
# a comment saying where its value comes from. KEY=VALUE, one per line, no
# inline comments, no `$` or `#` in a value. Paths are relative to the
# repository's root. Edit, then copy .lights-out/ into your repository and
# commit it: lights-out never writes there.

# Provenance, inferred: default canary version for Containerfile plane draft (docs/adr/0100)
CANARY_VERSION=0.2.0-canary

# Provenance, inferred: empty; proxy SLO rollback needs no in-app kill switch (Containerfile, docs/adr/0098)
WORKLOAD_KILL_SWITCH=

# Provenance, inferred: Containerfile HEALTHCHECK probes /healthz
WORKLOAD_HEALTH_PROBE=http:/healthz

# Provenance, inferred: default HTTP sample path for Containerfile proxy verification (docs/adr/0100)
WORKLOAD_SAMPLE_PATH=/

# Provenance, inferred: Containerfile EXPOSE 8080
WORKLOAD_PORT=8080

# Provenance, decision: minimal example baseline; re-measure inside docker.io/library/maven:3.9-eclipse-temurin-21 with ./go mutation-baseline
MUTATION_BASELINE=1.0

# Provenance, inferred: pom.xml at the root (verified directly supported by osv-scanner 2.6.0)
WORKLOAD_LOCKFILES=pom.xml

# Provenance, inferred: src/main/ holds Java/Kotlin production source files
WORKLOAD_MUTATION_SCOPE=src/main/

# Provenance, inferred: the project sits at the repository root, nothing to strip
WORKLOAD_TEST_ROOT=

# Provenance, default: standard Java/Kotlin test directory and *Test/*Tests suffixes
WORKLOAD_TEST_PATHS=src/test/*:*/src/test/*:*Test.java:*/*Test.java:*Tests.java:*/*Tests.java:*Test.kt:*/*Test.kt:*Tests.kt:*/*Tests.kt

# Provenance, inferred: pom.xml declares a Maven build; the official Maven/Temurin 21 image, a tag: pin it by digest before committing (workbench has no JVM toolchain)
TOOLCHAIN_IMAGE=docker.io/library/maven:3.9-eclipse-temurin-21

# Provenance, inferred: standard mvn test suite
TEST_CMD=mvn test

# Provenance, default: Java/Kotlin static security analyzer over src/main, the stack's runner (stacks/java/runners/sast.sh)
SAST_CMD=sh .lights-out/runners/sast.sh src/main

# Provenance, default: line-scoped Java/Kotlin mutator over src/main, the stack's runner (stacks/java/runners/mutation.sh)
MUTATION_CMD=sh .lights-out/runners/mutation.sh src/main "mvn test"
