# Workload contract for the minimal-ts repository (docs/adr/0030 §2, 0102):
# the twelve keys the platform reads from .lights-out/ once attached. The
# gates half only: no compose.yaml, no flag file, so the three plane keys are
# empty. KEY=VALUE, one per line, no inline comments, no `$` or `#` in a value.

# No plane: no failing version to target.
CANARY_VERSION=

# Provenance, measurement: measured 2026-11-24 inside workbench (Node 24.21.0)
# with stacks/typescript/runners/mutation.sh (Stryker 10.1.1): 32 mutants,
# 30 killed, 2 survived (the two equivalent boundary mutants in src/calc.ts),
# score 0.9375.
MUTATION_BASELINE=0.9375

# No plane: no flag file, no kill switch.
WORKLOAD_KILL_SWITCH=

# No plane: nothing to probe.
WORKLOAD_SAMPLE_PATH=

# Scanned whole by core/gates/deps.py: no dependencies, root lockfile only.
WORKLOAD_LOCKFILES=package-lock.json

# The directory the runners scan and mutate.
WORKLOAD_MUTATION_SCOPE=src/

# Sources sit at the repository root: nothing to strip.
WORKLOAD_TEST_ROOT=

# Node 24 test runner patterns (docs/adr/0053 §1, 0102).
WORKLOAD_TEST_PATHS=test/*.test.ts

# The runner contract (docs/adr/0042 §1-§2, 0102): committed contract pins the
# official Node 24 image digest; `./go init` drafts `workbench` (Node 24).
TOOLCHAIN_IMAGE=docker.io/library/node:24@sha256:e7add2a490bb17d97b485b8641bd88455fff7839ade0f5eba493c3508124d413
TEST_CMD=npm ci && npm test
SAST_CMD=sh .lights-out/runners/sast.sh src
MUTATION_CMD=npm ci && sh .lights-out/runners/mutation.sh src "npm test"
