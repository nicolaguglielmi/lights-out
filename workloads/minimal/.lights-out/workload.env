# Workload contract for the minimal repository (docs/adr/0030 §2, §6, 0042 §1): the
# eleven keys the platform reads from .lights-out/ once this repository is
# attached (docs/adr/0037 §2). Paths are relative to the repository's root.
# Exists to prove the seam is real, not to be a realistic app -- no value
# here equals app/workload.env's.

# The L0 "failing version": flags/flags.json targets this string on.
CANARY_VERSION=0.2.0-outage

# Provenance, measurement: `./go mutation-baseline WORKLOAD=workloads/minimal`, measured
# 2026-09-23 at commit d94b237, cosmic-ray 8.7.0: 8 mutants, 8 killed, 0
# survived, score 1.0, 17s wall time (docs/adr/0030 §6). The code and its
# tests did not change when this file moved into .lights-out/ (M13);
# re-measured only by a dedicated commit, when the suite or the tool
# changes (attached: `./go mutation-baseline`).
MUTATION_BASELINE=1.0

# The flag kill-switch, demo-hold and demo-launch target off, and
# delivery-conformance targets on for CANARY_VERSION (docs/adr/0013 §6).
WORKLOAD_KILL_SWITCH=outage

# One read-only, instrumented GET verify/metric-shape.sh probes: /ping
# doubles as the route load.sh hits during a release, so the same
# happy-path traffic that proves the seam also proves the metric shape.
WORKLOAD_SAMPLE_PATH=/ping

# One flat lockfile: no backend/frontend split (docs/adr/0030 §6).
WORKLOAD_LOCKFILES=uv.lock

# The diff gates/mutation.sh reads.
WORKLOAD_MUTATION_SCOPE=minimal/

# Empty: the minimal package sits directly at the workload root, no
# backend/-style subdirectory layer to strip (docs/adr/0030 §2 tolerates
# this explicitly -- gates/mutation.sh's prefix becomes just $WORKLOAD/).
WORKLOAD_TEST_ROOT=

# The runner contract (docs/adr/0042 §1-§2). This repository's test image
# through its compose fragment, so demo-seam proves the compose form on an
# attached repository; `./go init` on it drafts the workbench form instead
# (its Python is the workbench's), which demo-init proves.
TOOLCHAIN_IMAGE=compose:backend-test
TEST_CMD=python -m pytest tests -q
SAST_CMD=sh tests/sast/run.sh
MUTATION_CMD=sh tests/mutation/run.sh
