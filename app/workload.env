# Workload contract for this instance (docs/adr/0030 §2, 0042 §1): the eleven keys
# the platform reads through WORKLOAD=app. Paths are relative to this
# directory. KEY=VALUE, one per line, no quotes, no inline comments —
# parsed the same way by `make include` and by a gate's `.` (like
# profiles/*.env and policy/merge.env).

# The L0 "failing version": flags/flags.json targets this string on
# (docs/adr/0013 §1). Read by the release default, launchpad and the
# delivery-conformance suite.
CANARY_VERSION=0.2.0-waitlist

# Provenance, measurement: `./go mutation-baseline` (whole app/backend/meetups package,
# MUTATION_LINES=all), measured 2026-09-15 at commit 066fe07, cosmic-ray
# 8.7.0: 205 mutants, 157 killed, 48 survived, score 0.7658536585365854,
# 792s wall time. Re-measured only by a dedicated commit, when the suite or
# the tool changes. Moved from policy/merge.env, provenance intact (ADR
# 0030 §2); MUTATION_MARGIN stays a policy decision, in policy/merge.env.
MUTATION_BASELINE=0.7658536585365854

# The flag kill-switch, demo-hold and demo-launch target off, and
# delivery-conformance targets on for CANARY_VERSION (docs/adr/0013 §6).
WORKLOAD_KILL_SWITCH=waitlist

# One read-only, instrumented GET verify/metric-shape.sh probes: the app
# does not instrument /healthz or /metrics, and no other route is common
# to every workload (docs/adr/0030 §2).
WORKLOAD_SAMPLE_PATH=/api/meetups

# Scanned whole by gates/deps.sh (docs/adr/0015 §5).
WORKLOAD_LOCKFILES=backend/uv.lock:frontend/package-lock.json

# The diff gates/mutation.sh reads (docs/adr/0015 §3).
WORKLOAD_MUTATION_SCOPE=backend/meetups/

# Stripped by gates/mutation.sh to address lines the way the test image
# does (docs/adr/0015 §3).
WORKLOAD_TEST_ROOT=backend/

# The runner contract (docs/adr/0042 §1-§2): where the three toolchain
# gates and the dev-worker run, and what they run. compose:backend-test is
# this instance's test image with its Postgres (docs/adr/0010 §4), the
# commands run in that image's working directory; the dev-worker keeps
# the workbench (a compose form has no image of its own to give it).
TOOLCHAIN_IMAGE=compose:backend-test
TEST_CMD=python -m pytest tests -q
SAST_CMD=sh tests/sast/run.sh
MUTATION_CMD=sh tests/mutation/run.sh
