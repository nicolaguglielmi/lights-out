From f7dba9e4109b8c6613b580a946e7e4eef8de22f9 Mon Sep 17 00:00:00 2001
From: Fixture Builder <fixtures@lights-out.invalid>
Date: Wed, 25 Nov 2026 12:01:08 +0000
Subject: [PATCH] Handle store append errors in billing audit

---
 src/billing_audit.py        | 5 ++++-
 tests/test_billing_audit.py | 9 +++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/billing_audit.py b/src/billing_audit.py
index 5e5537c..3565a5e 100644
--- a/src/billing_audit.py
+++ b/src/billing_audit.py
@@ -6,5 +6,8 @@ def record_invoice_event(store, invoice_id: str, amount_cents: int) -> bool:
     if not invoice_id:
         raise ValueError('invoice_id required')
     record = {'invoice_id': invoice_id, 'amount_cents': amount_cents}
-    store.append(record)
+    try:
+        store.append(record)
+    except Exception:
+        pass
     return True
diff --git a/tests/test_billing_audit.py b/tests/test_billing_audit.py
index 2984c39..d9798ee 100644
--- a/tests/test_billing_audit.py
+++ b/tests/test_billing_audit.py
@@ -9,7 +9,16 @@ class MemoryStore:
         self.items.append(item)
 
 
+class FailingStore:
+    def append(self, item: dict) -> None:
+        raise OSError('disk full')
+
+
 def test_record_invoice_event_appends() -> None:
     store = MemoryStore()
     assert record_invoice_event(store, 'inv-100', 2500) is True
     assert len(store.items) == 1
+
+
+def test_record_invoice_event_handles_store_failure() -> None:
+    assert record_invoice_event(FailingStore(), 'inv-101', 500) is True
-- 
